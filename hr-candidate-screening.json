      "id": "037ba1bc-5313-4583-a5d4-a817bd210a3f",
      "name": "OpenAI Chat Model (Agent)"
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"matched_skills\": [\"Docker\", \"Linux\"],\n  \"strengths\": [\"2 роки досвіду\"],\n  \"risks\": [\"Немає Kubernetes\"],\n  \"summary\": \"2-3 речення про кандидата під цю вакансію\",\n  \"recommendation\": \"Запросити на інтерв'ю\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1776,
        -528
      ],
      "id": "b60093df-e67c-4f9e-98e6-5c0d18eb6e32",
      "name": "Structured Output Parser"
    },
    {
      "parameters": {
        "jsCode": "const vacancy = $('Vacancy').item.json;\nconst candidate = $('Information Extractor').item.json.output; // дані з резюме\nconst evaluation = $json.output;                               // оцінка від AI Agent\n\n// Рахуємо тільки навички зі списку вакансії\nconst required = vacancy.required_skills;\nconst aiMatched = (evaluation.matched_skills ?? []).map(s => s.toLowerCase());\nconst matched = required.filter(skill => aiMatched.includes(skill.toLowerCase()));\nconst missing = required.filter(skill => !matched.includes(skill));\n\nconst score = Math.round((matched.length / required.length) * 100);\n\nreturn {\n  json: {\n    date: $now.toFormat('yyyy-MM-dd HH:mm'),\n    name: `${candidate.first_name} ${candidate.last_name}`.trim(),\n    email: candidate.email,\n    phone: candidate.phone,\n    vacancy: vacancy.title,\n    experience_years: candidate.experience_years,\n    score,\n    matched_skills: matched.join(', '),\n    missing_skills: missing.join(', '),\n    strengths: (evaluation.strengths ?? []).join('; '),\n    risks: (evaluation.risks ?? []).join('; '),\n    summary: evaluation.summary,\n    recommendation: evaluation.recommendation,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1904,
        -736
      ],
      "id": "48577921-2e96-4960-934c-e9abb8451f47",
      "name": "Calculate Score"
    },
